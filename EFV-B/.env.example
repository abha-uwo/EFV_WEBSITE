# EFV Backend Environment Variables Template
PORT=8080
NODE_ENV=development

# Database Configuration (Atlas / MongoDB URI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=EFV
USE_JSON_DB=false
DEMO_MODE=false

# Authentication & Security
JWT_SECRET=your_super_strong_random_jwt_secret_key
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=your_secure_admin_seed_password

# Google Cloud Platform & Storage
GCP_PROJECT_ID=your-gcp-project-id
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-ebook-bucket
GCS_COVER_BUCKET_NAME=your-cover-bucket
GCS_RAG_BUCKET_NAME=your-rag-bucket
GCS_KEY_FILE_PATH=./gcp-key.json

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_MODE=sandbox

# Cashfree Payment Gateway
PAYMENT_GATEWAY=razorpay
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_MODE=sandbox
CASHFREE_BASE_URL=https://sandbox.cashfree.com

# Email Notifications (SMTP / Gmail App Password)
EMAIL_USER=admin@example.com
EMAIL_PASS=your_email_app_password

# Shipping Integration (NimbusPost)
NIMBUS_EMAIL=your_nimbus_account_email
NIMBUS_PASSWORD=your_nimbus_account_password

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Domain / URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# IPData Geolocation API Configuration (Official API: https://ipdata.co)
IPDATA_API_KEY=your_ipdata_api_key_here
IPDATA_CACHE_TTL_MS=86400000
IPDATA_TIMEOUT_MS=3000
DEFAULT_COUNTRY_CODE=IN
ALLOW_TEST_IP=false

